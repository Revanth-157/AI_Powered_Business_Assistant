# FastAPI Backend Configuration
# Copy to .env and update values for your environment

# App Settings
DEBUG=False
APP_NAME="FMCG BI Assistant"
VERSION="1.0.0"
API_PREFIX="/api/v1"

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database - PostgreSQL (production)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/fmcg_ai
DATABASE_ECHO=False

# Database - SQLite (development fallback)
USE_SQLITE=True
SQLITE_DB_PATH=../architecture/fmcg_analytics.db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8501","http://127.0.0.1:3000","http://127.0.0.1:8000","http://127.0.0.1:8501"]

# LLM Configuration (OpenAI)
OPENAI_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7

# AI Agents
AI_DATABASE_PATH=../architecture/fmcg_analytics.db
AGENT_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Session/Cache
SESSION_TIMEOUT_MINUTES=60
CACHE_ENABLED=True
