APP_NAME=FMCG BI Assistant
VERSION=1.0.0
DEBUG=True
LOG_LEVEL=DEBUG

# Database Configuration
USE_SQLITE=True
SQLITE_DB_PATH=C:\Users\revan\Downloads\AI_Project\architecture\fmcg_analytics.db
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fmcg_ai

# Security
SECRET_KEY=dev-secret-key-change-in-production-to-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8501"]

# LLM Configuration
ENABLE_LLM=False
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
OPENAI_API_KEY=sk-

# AI Agent Configuration
AI_DATABASE_PATH=../architecture/fmcg_analytics.db
AGENT_TIMEOUT=30

# API Configuration
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Session Configuration
SESSION_TIMEOUT_MINUTES=480
CACHE_ENABLED=True

# Logging
LOG_FILE=logs/app.log
